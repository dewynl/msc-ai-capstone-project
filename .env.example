# Educational T5 Project Environment Variables
# Copy this file to .env and customize as needed

#=============================================================================
# REQUIRED - API KEYS
#=============================================================================

# Anthropic API (required for synthetic data generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

#=============================================================================
# PROJECT DIRECTORIES
#=============================================================================

# Data directories (currently used)
DATA_DIR=./data
SYNTHETIC_DATA_DIR=./data/synthetic

#=============================================================================
# COMPUTE CONFIGURATION
#=============================================================================

# CPU optimization for development (WSL2 + AMD GPU not supported)
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false

# GPU settings (for when moving to native Linux with ROCm)
# CUDA_VISIBLE_DEVICES=0
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

#=============================================================================
# SYNTHETIC DATA GENERATION (CURRENT FOCUS)
#=============================================================================

# Claude API settings
ANTHROPIC_MODEL=claude-sonnet-4-20250514
RATE_LIMIT_DELAY=2.0

# Dataset targets (current goal: 4000 samples)
TARGET_TOTAL_SYLLABI=4000

#=============================================================================
# DEVELOPMENT SETTINGS
#=============================================================================

# Logging
LOG_LEVEL=INFO

# Reproducibility
RANDOM_SEED=42
