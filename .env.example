# Educational T5 Project Environment Variables
# Copy this file to .env and customize as needed

#=============================================================================
# EDUCRAFT WEB APP - REQUIRED FOR STREAMLIT APP
#=============================================================================

# Supabase Database (required for EduCraft web interface)
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

#=============================================================================
# DATA GENERATION - OPTIONAL (only if regenerating training data)
#=============================================================================

# Anthropic API (optional - only for synthetic data generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

#=============================================================================
# PROJECT DIRECTORIES
#=============================================================================

# Data directories (currently used)
DATA_DIR=./data
SYNTHETIC_DATA_DIR=./data/synthetic

#=============================================================================
# COMPUTE CONFIGURATION
#=============================================================================

# CPU optimization for development (WSL2 + AMD GPU not supported)
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false

# GPU settings (for when moving to native Linux with ROCm)
# CUDA_VISIBLE_DEVICES=0
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

#=============================================================================
# SYNTHETIC DATA GENERATION - OPTIONAL (legacy, not needed for EduCraft)
#=============================================================================

# Claude API settings (optional - only if regenerating training data)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# RATE_LIMIT_DELAY=2.0
# TARGET_TOTAL_SYLLABI=4000

#=============================================================================
# DEVELOPMENT SETTINGS
#=============================================================================

# Logging
LOG_LEVEL=INFO

# Reproducibility
RANDOM_SEED=42
